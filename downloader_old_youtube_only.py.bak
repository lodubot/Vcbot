import os
import yt_dlp
from config import CACHE_DIR
import db

def clean_text(text: str) -> str:
    if not text:
        return "Unknown"
    return str(text).replace("`", "").replace("*", "").replace("_", "").replace("<", "").replace(">", "").strip()

def resolve_track(query: str, is_video: bool = False):
    print(f"📡 Resolving track via Direct Stream URL for: {query}")
    
    ydl_opts = {
        'format': 'bestaudio/best',
        'quiet': True,
        'no_warnings': True,
        'geo_bypass': True,
        'nocheckcertificate': True,
        'cookiefile': 'cookies.txt',
        'extractor_args': {
            'youtube': {
                'player_client': ['web', 'mweb', 'android']
            }
        }
    }

    try:
        if "youtube.com" in query or "youtu.be" in query:
            search_target = query
        else:
            search_target = f"ytsearch1:{query}"

        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(search_target, download=False) # 👈 Yahan download=False hai taaki file download na ho, direct link mile
            if 'entries' in info and len(info['entries']) > 0:
                info = info['entries'][0]

            vid_id = info.get('id')
            
            # Direct audio stream URL nikalna
            audio_url = None
            for f in info.get('formats', []):
                if f.get('acodec') != 'none' and f.get('vcodec') == 'none':
                    audio_url = f.get('url')
                    break
            
            if not audio_url:
                audio_url = info.get('url') # Fallback to best format URL

            song_data = {
                "id": vid_id,
                "title": clean_text(info.get('title', 'Unknown Title')),
                "artist": clean_text(info.get('uploader', 'YouTube Artist')),
                "duration": info.get('duration', 0),
                "thumbnail": info.get('thumbnail', ''),
                "local_path": audio_url, # 👈 PyTgCalls ko direct streaming URL mil jayega
                "is_video": False
            }

            db.save_song(
                song_data["id"], song_data["title"], song_data["artist"],
                song_data["duration"], song_data["thumbnail"], song_data["local_path"]
            )
            return song_data
            
    except Exception as err:
        raise Exception(f"All Downloaders Failed: {err}")
